// Publishes the built documentation site (docs/.vitepress/dist) as static files on Cloudflare.
//   pnpm docs:build && pnpm docs:deploy
{
  "name": "thousand-sandbox-docs",
  "compatibility_date": "2026-11-10",
  // The site's address. Cloudflare creates the DNS record and the certificate.
  "routes": [{ "pattern": "docs.usethousand.com", "custom_domain": true }],
  "assets": {
    "directory": "./.vitepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
